# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Supabase (Auth + Postgres + Storage) ─────────────────────────────────
# Supabase Dashboard → Project Settings → API.
#
# NEXT_PUBLIC_SUPABASE_ANON_KEY is the public anon key. It is safe in the
# browser: row level security is what protects customer data.
#
# SUPABASE_SERVICE_ROLE_KEY is SERVER-ONLY. It bypasses RLS. It must never be
# imported by a "use client" module and must never appear in the client bundle.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Public bucket for product media. Created by supabase/migrations/0004_storage.sql.
SUPABASE_STORAGE_BUCKET="ongod-media"

# ── Supabase Postgres — MIGRATIONS ONLY ─────────────────────────────────
# Used exclusively by scripts/migrate.mjs, scripts/create-admin.mjs and
# scripts/import-media.mjs. No application module ever reads this.
# Supabase Dashboard → Connection string → Session pooler.
SUPABASE_DB_URL=""

# ── Control Room operator ───────────────────────────────────────────────
# No operator credential lives in this file, and that is deliberate.
#
# Supabase Auth owns the password — create the account in the dashboard under
# Authentication → Users. This project only owns the GRANT, which is the
# admin_users row saying what that account may see:
#
#   npm run admin:grant you@yourdomain.com
#
# Deleting that row demotes the account to an ordinary customer immediately.

# ── Razorpay ──────────────────────────────────────────────────
# Order placement works without any of these: the order is created, its stock
# is held for 30 minutes, payment_status stays PENDING, and /checkout says
# exactly that rather than opening a payment sheet that cannot work.
#
# Onboarding requires a REGISTERED BUSINESS with a matching PAN and a business
# bank account — a personal savings account will not be accepted.
#
# KEY_ID is public: the hosted sheet is opened in the browser. KEY_SECRET and
# WEBHOOK_SECRET are server-only and must never reach the client bundle.
#
#   key_id / key_secret      Razorpay Dashboard → Settings → API keys
#   webhook_secret           Razorpay Dashboard → Settings → Webhooks, generated
#                            on the webhook itself and different from key_secret.
#                            Signatures are HMAC-SHA256 over the RAW request body.
#
#   Webhook endpoint:  https://<your-domain>/api/webhooks/razorpay
#   Subscribe to:      payment.captured, payment.failed, refund.processed
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_WEBHOOK_SECRET=""

# ── Cron ─────────────────────────────────────────────────
# Bearer token for GET /api/cron/expire, which returns stock held by unpaid
# orders whose 30-minute window closed. Vercel supplies CRON_SECRET itself;
# set it by hand anywhere else. Unset means the route refuses every caller.
# place_order() also sweeps on its own, so this is not load-bearing.
CRON_SECRET=""
